# Normalise line endings for source text; binary assets are never diffed.
# No Git LFS is used in this repo - asset bundles live on a GitHub Release.
* text=auto eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.glb binary
*.gltf text
*.blend binary
*.zip binary
*.gz binary
