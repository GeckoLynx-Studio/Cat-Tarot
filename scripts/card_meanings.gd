static func get_meaning(card_id: int, orientation: String) -> Dictionary:
	var entry: Dictionary = MEANINGS.get(card_id, {})
	if entry.is_empty():
		return {"keywords": "", "meaning": ""}
	var reversed := str(orientation).to_upper() == "REVERSED"
	var suffix := "reversed" if reversed else "upright"
	var lang := Loc.language if Loc.language == "zh" else "en"
	return {
		"keywords": str(entry.get("keywords_" + suffix + "_" + lang, "")),
		"meaning": str(entry.get("meaning_" + suffix + "_" + lang, "")),
	}
