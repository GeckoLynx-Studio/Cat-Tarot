#!/bin/sh
# Enforce the commit message specification (see AGENTS.md):
#   <type>(<scope>): <summary>
#
#   <body>
#
#   Signed-off-by: <name> <email>
# The sign-off must match `git config user.name` / `git config user.email`.
msg_file="$1"
first=$(head -n 1 "$msg_file")

case "$first" in
  "Merge "*|"Revert "*|fixup!*|squash!*) exit 0 ;;
esac

# 1) header: conventional type + REQUIRED scope + summary
if ! printf '%s\n' "$first" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)\([a-zA-Z0-9._/-]+\)!?: .+'; then
  echo "commit-msg: header must be 'type(scope): summary' with a scope." >&2
  echo "  e.g. 'fix(cards): stop ghost clicks' - types: feat fix docs style refactor perf test build ci chore revert" >&2
  exit 1
fi

# 2) body: at least one non-empty, non-trailer, non-comment line after the header
body=$(awk 'NR > 1 && $0 !~ /^#/ && $0 !~ /^[[:space:]]*$/ && $0 !~ /^(Signed-off-by|Co-authored-by|Refs|Closes|Fixes):/ { print; exit }' "$msg_file")
if [ -z "$body" ]; then
  echo "commit-msg: add a body (blank line after the summary) explaining what and why." >&2
  exit 1
fi

# 3) Signed-off-by trailer, derived from git config
name=$(git config user.name || true)
email=$(git config user.email || true)
if [ -z "$name" ] || [ -z "$email" ]; then
  echo "commit-msg: set git config user.name and user.email before committing." >&2
  exit 1
fi
expected="Signed-off-by: $name <$email>"
if ! grep -qxF "$expected" "$msg_file"; then
  echo "commit-msg: missing or mismatched sign-off trailer." >&2
  echo "  expected: $expected" >&2
  echo "  add it as the last line (values come from git config user.name / user.email)." >&2
  exit 1
fi
exit 0
